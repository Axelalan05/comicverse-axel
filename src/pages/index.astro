---
import Base from '../layouts/Base.astro';
import ComicCard from '../components/ComicCard.astro';
import {comics} from '../data/comics.js';
import '../styles/story-link.css';
---
<Base><section class="hero"><div class="container hero-grid"><div class="hero-copy"><span class="eyebrow">TU UNIVERSO DE HISTORIAS</span><h1>Grandes héroes.<br/><em>Historias épicas.</em></h1><p>De las calles de Nueva York a los eventos más grandes de Marvel. Encontrá tu próxima lectura en ComicVerse.</p><div class="hero-actions"><a class="btn primary" href="/tienda">Explorar cómics ↗</a><a class="btn ghost" href="#destacados">Ver destacados ↓</a><a class="btn story-link" href="/historia-spiderman"><span class="story-link-icon" aria-hidden="true">🕷️</span> Ver la historia de Spider-Man</a></div><div class="hero-stats"><span><b>9</b> títulos clásicos</span><span><b>3</b> universos</span><span><b>∞</b> aventuras</span></div></div><div class="hero-art"><img src="/img/comicportada.jpeg" alt="Portada de cómic Marvel"/><div class="floating-label">EL UNIVERSO MARVEL<br/><strong>TE ESPERA</strong></div></div></div></section><section id="destacados" class="section container"><div class="section-head"><div><span class="eyebrow red">SELECCIÓN COMICVERSE</span><h2>Historias destacadas</h2><p>Una selección de nuestro catálogo original.</p></div><a href="/tienda" class="text-link">Ver todo el catálogo →</a></div><div class="comic-grid">{comics.slice(0,4).map(comic=><ComicCard comic={comic}/>)}</div></section><section class="banner"><div class="container"><span class="eyebrow">DESCUBRÍ TU PRÓXIMA HISTORIA</span><h2>Tu próxima aventura comienza acá.</h2><a class="btn light" href="/tienda">Ir a la tienda →</a></div></section></Base>
