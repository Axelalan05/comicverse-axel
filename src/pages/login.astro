import Base from '../layouts/Base.astro';
---
<Base title="Ingresá a tu cuenta | ComicVerse"><section class="auth-section"><div class="auth-card"><span class="eyebrow red">COMICVERSE</span><h1>Ingresá a tu cuenta</h1><p>Esta sección es una demostración visual. Todavía no hay autenticación real.</p><form id="demo-form" data-astro-reload><label>Correo electrónico<input type="email" placeholder="Correo electrónico" required/></label><label>Contraseña<input type="password" placeholder="Contraseña" required/></label><button class="btn primary" type="submit">Ingresar</button></form><p id="form-notice" role="status" hidden>La autenticación todavía no está habilitada.</p><a class="text-link" href="/registro">¿No tenés cuenta? Registrate</a></div></section></Base>
